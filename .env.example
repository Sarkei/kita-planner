# API (Browser): Lokal Dev → Backend auf :5000; Docker-Produktion: /api (gleicher Prozess wie die SPA).
VITE_API_URL=http://localhost:5000/api

# Mistral AI: Angebots-Text per Chat Completions; Bilder per Conversations + image_generation (Beta).
# In Docker: `MISTRAL_API_KEY` in `.env` → Service `app`; beim Start inline in `index.html` (kein separates config.js, um 403/WAF zu vermeiden).
# Lokal: gleicher Key aus dieser `.env` über Vite (`define`).
MISTRAL_API_KEY=

# Optional: Modell-Overrides; nach Änderung App-Image neu bauen (`docker compose build app`).
# VITE_MISTRAL_TEXT_MODEL=mistral-large-latest
# VITE_MISTRAL_IMAGE_CONVERSATION_MODEL=mistral-medium-latest

# IMPORTANT: Do NOT commit your real key.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kita_planner
