# --- KI (bleibt im Server, landet nie im Browser) ---
# Text: auto = DeepSeek, falls gesetzt, sonst Mistral. Feste Wahl: deepseek | mistral
AI_TEXT_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-chat
# Nur für Bilder (Kamishibai/Illustrationen) — DeepSeek kann keine Bilder.
MISTRAL_API_KEY=
MISTRAL_IMAGE_CONVERSATION_MODEL=mistral-medium-latest
# Höchstens so viele KI-Anfragen pro Stunde und Besucher-IP
AI_RATE_LIMIT_PER_HOUR=120

# --- Datenbank ---
POSTGRES_USER=kita
POSTGRES_PASSWORD=
POSTGRES_DB=kita_planner

# --- Sonstiges ---
# Port nach außen (Standard 4466)
# APP_PORT=4466
# Nur nötig, wenn ein separater Dev-Server auf die API zugreift
# CORS_ORIGIN=http://localhost:3000
